# Local run outputs (created by ad-hoc pipeline runs)
tilescope_output/

# EDA derived per-spot artefacts (regeneratable from scripts).
# Keep summaries, per_sample_summary.csv, and report.md — those are
# small, human-readable, and the audit trail. Per-spot ledgers can
# be tens of MB per repo commit and are trivially regeneratable.
docs/eda/output/**/*_ledger.csv

# Stray test-output artifacts (pytest writing outside python/tilescope/tests/)
/tests/

